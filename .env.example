# Copy to .env.local and fill in. Never commit the real file.

# --- LiveKit (required) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM: livekit (default) | openai | gemini | custom | auto ---
LLM_PROVIDER=livekit
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
# for custom / auto (any OpenAI-compatible server, e.g. Groq)
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=

# --- voice tuning (optional) ---
STT_LANGUAGE=en
NOISE_CANCEL=off
PREEMPTIVE=off
MIN_ENDPOINTING=0.8
MAX_ENDPOINTING=4.0
MIN_INTERRUPTION_WORDS=2
MIN_INTERRUPTION_SECONDS=0.8
MAX_TOOL_STEPS=3
MAX_CALL_SECONDS=480
IDLE_HANGUP_SECONDS=90

# --- web app ---
VOICE_AGENT_DB=
